# --- Bắt buộc ---
DATABASE_URL=postgres://mta:mta@localhost:5432/mta
REDIS_URL=redis://localhost:6379/0
# >= 32 ký tự ngẫu nhiên:  openssl rand -base64 48
JWT_ACCESS_SECRET=
# "id:hex,id:hex" — mục đầu là khóa hiện hành; mỗi khóa >= 32 byte hex:  openssl rand -hex 32
# Xoay khóa: thêm khóa mới LÊN ĐẦU, giữ khóa cũ phía sau cho tới khi hết mã cũ.
ACTIVATION_PEPPERS=1:

# --- Tùy chọn (giá trị mặc định trong ngoặc) ---
# NODE_ENV=development  PORT=3001
# TRUST_PROXY=0          # số tầng reverse proxy TIN CẬY (chỉ tin X-Forwarded-For từ proxy của mình)
# ALLOWED_ORIGINS=http://localhost:3000   # bắt buộc ở production (kiểm tra Origin cho POST)
# WEB_BASE_URL=http://localhost:3000
# COOKIE_SECURE=true (production)
# ACCESS_TTL_SEC=900  REFRESH_TTL_DAYS=30  REFRESH_FAMILY_MAX_DAYS=90  REFRESH_GRACE_SEC=10
# LOGIN_FAIL_EMAIL_LIMIT=10  LOGIN_FAIL_IP_LIMIT=50  ACT_FAIL_USER_LIMIT=5  ACT_FAIL_IP_LIMIT=100
# RL_TRUSTED_MULTIPLIER=10   # nhân ngưỡng theo IP cho mạng tin cậy của trung tâm
# MINOR_AGE_THRESHOLD=16     # [Cần xác nhận pháp chế]
# HIBP_ENABLED=false
